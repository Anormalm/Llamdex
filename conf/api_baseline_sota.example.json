{
  "api_base_url": "https://api.openai.com/v1",
  "api_chat_path": "/chat/completions",
  "api_key_env": "OPENAI_API_KEY",
  "timeout_s": 120,
  "dataset_name": "dtd",
  "data_root": "./data",
  "task_family": "single_image",
  "qa_type": "label_code",
  "population_output_mode": "integer",
  "population_group_size": 8,
  "batch_size": 1,
  "max_eval_samples": 32,
  "seed": 42,
  "enable_llm_only": true,
  "enable_two_stage": true,
  "enable_vlm_direct": true,
  "enable_rag": true,
  "caption_prompt": "Describe this image in one short sentence.",
  "rag_db_size": 128,
  "llm_models": [
    {
      "name": "gpt-4.1",
      "model_id": "gpt-4.1",
      "enabled": true,
      "is_vision": false
    },
    {
      "name": "qwen3-235b",
      "model_id": "Qwen/Qwen3-235B-A22B-Instruct",
      "enabled": false,
      "is_vision": false
    }
  ],
  "vlm_models": [
    {
      "name": "gpt-4o",
      "model_id": "gpt-4o",
      "enabled": true,
      "is_vision": true
    },
    {
      "name": "qwen2.5-vl-72b",
      "model_id": "Qwen/Qwen2.5-VL-72B-Instruct",
      "enabled": false,
      "is_vision": true
    }
  ],
  "out_csv": "runs/api_baseline_suite_results.csv",
  "out_json": "runs/api_baseline_suite_results.json"
}

