{
  "api_base_url": "https://api.openai.com/v1",
  "api_chat_path": "/chat/completions",
  "api_key_env": "OPENAI_API_KEY",
  "timeout_s": 120,
  "api_max_retries": 4,
  "api_retry_base_s": 1.0,
  "api_retry_max_s": 12.0,
  "api_retry_jitter_s": 0.3,
  "dataset_names": ["dtd", "oxford_pet"],
  "data_root": "/disk1/lfhu/data",
  "task_family": "single_image",
  "qa_type": "yesno",
  "population_output_mode": "integer",
  "population_group_size": 8,
  "batch_size": 1,
  "max_eval_samples": 64,
  "seed": 42,
  "eval_repeats": 1,
  "repeat_seed_stride": 1000,
  "enable_llm_only": true,
  "enable_two_stage": true,
  "enable_vlm_direct": true,
  "enable_rag": true,
  "caption_prompt": "Describe this image in one short sentence.",
  "rag_db_size": 128,
  "llm_models": [
    {"name": "gpt-4.1", "provider": "openai_compatible", "model_id": "gpt-4.1", "enabled": true, "is_vision": false},
    {"name": "gpt-4.1-mini", "provider": "openai_compatible", "model_id": "gpt-4.1-mini", "enabled": true, "is_vision": false}
  ],
  "vlm_models": [
    {"name": "gpt-4o", "provider": "openai_compatible", "model_id": "gpt-4o", "enabled": true, "is_vision": true},
    {"name": "gpt-4o-mini", "provider": "openai_compatible", "model_id": "gpt-4o-mini", "enabled": true, "is_vision": true}
  ],
  "out_csv": "/disk1/lfhu/runs/api_baseline_sota_model_swap_eval.csv",
  "out_json": "/disk1/lfhu/runs/api_baseline_sota_model_swap_eval.json",
  "out_summary_csv": "/disk1/lfhu/runs/api_baseline_sota_model_swap_eval.summary.csv",
  "out_summary_json": "/disk1/lfhu/runs/api_baseline_sota_model_swap_eval.summary.json",
  "hf_cache_dir": "/disk1/lfhu/hf_cache"
}
