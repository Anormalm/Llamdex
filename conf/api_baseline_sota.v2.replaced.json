{
  "api_base_url": "https://api.openai.com/v1",
  "api_chat_path": "/chat/completions",
  "api_key_env": "OPENAI_API_KEY",
  "timeout_s": 120,
  "api_max_retries": 4,
  "api_retry_base_s": 1.0,
  "api_retry_max_s": 12.0,
  "api_retry_jitter_s": 0.25,
  "dataset_names": [
    "dtd",
    "oxford_pet"
  ],
  "data_root": "./data",
  "task_family": "single_image",
  "qa_type": "yesno",
  "batch_size": 1,
  "max_eval_samples": 16,
  "seed": 42,
  "eval_repeats": 1,
  "enable_llm_only": true,
  "enable_two_stage": true,
  "enable_vlm_direct": true,
  "enable_rag": true,
  "llm_models": [
    {
      "name": "gpt-4.1",
      "provider": "openai_compatible",
      "model_id": "gpt-4.1",
      "enabled": true,
      "is_vision": false
    },
    {
      "name": "gpt-4.1-mini",
      "provider": "openai_compatible",
      "model_id": "gpt-4.1-mini",
      "enabled": true,
      "is_vision": false
    }
  ],
  "vlm_models": [
    {
      "name": "gpt-4o",
      "provider": "openai_compatible",
      "model_id": "gpt-4o",
      "enabled": true,
      "is_vision": true
    },
    {
      "name": "gpt-4o-mini",
      "provider": "openai_compatible",
      "model_id": "gpt-4o-mini",
      "enabled": true,
      "is_vision": true
    }
  ],
  "out_csv": "runs/api_baseline_suite_v2_replaced.csv",
  "out_json": "runs/api_baseline_suite_v2_replaced.json",
  "out_summary_csv": "runs/api_baseline_suite_v2_replaced.summary.csv",
  "out_summary_json": "runs/api_baseline_suite_v2_replaced.summary.json"
}
